rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signed(){return request.auth!=null;} function shortText(v,min,max){return v is string && v.size()>=min && v.size()<=max;} match /communityVisitors/{visitorId}{
 allow read:if true;
 allow create:if request.resource.data.keys().hasOnly(['firstSeen'])
   && request.resource.data.keys().hasAll(['firstSeen'])
   && visitorId.size()==36
   && request.resource.data.firstSeen==request.time;
 allow update,delete:if false;
}
match /communityPresence/{sessionId}{
 allow read:if true;
 allow create,update:if sessionId.size()==36
   && request.resource.data.keys().hasOnly(['lastSeen'])
   && request.resource.data.keys().hasAll(['lastSeen'])
   && request.resource.data.lastSeen==request.time;
 allow delete:if false;
}
match /profiles/{uid}{allow read:if true;allow create,update:if signed()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['name','city','updatedAt'])&&shortText(request.resource.data.name,2,60)&&shortText(request.resource.data.city,0,70);allow delete:if false;} match /posts/{postId}{allow read:if resource.data.status=='published';allow create:if signed()&&request.resource.data.keys().hasAll(['uid','author','title','body','city','createdAt','status'])&&request.resource.data.keys().hasOnly(['uid','author','title','body','city','createdAt','status','category','imageUrls'])&&(!request.resource.data.keys().hasAny(['imageUrls'])||(request.resource.data.imageUrls is list&&request.resource.data.imageUrls.size()<=3&&request.resource.data.imageUrls.size()>0&&request.resource.data.imageUrls[0] is string))&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=='published'&&request.resource.data.createdAt==request.time&&shortText(request.resource.data.author,1,100)&&shortText(request.resource.data.title,4,120)&&shortText(request.resource.data.body,10,2000)&&shortText(request.resource.data.city,1,70)&&(!request.resource.data.keys().hasAny(['category'])||(request.resource.data.category in ['General','Întrebări','Muncă','Locuințe','Evenimente','Ajutor','Povești din Italia','Reflecții despre diaspora','Locuri de muncă','Orașul meu','Publicitate gratuită']));allow update,delete:if false;match /votes/{voterUid} {
 allow read: if get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published';
 allow create, update: if signed()
   && request.auth.uid == voterUid
   && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published'
   && request.resource.data.keys().hasOnly(['uid','value','updatedAt'])
   && request.resource.data.keys().hasAll(['uid','value','updatedAt'])
   && request.resource.data.uid == voterUid
   && request.resource.data.value in [-1,0,1]
   && request.resource.data.updatedAt == request.time;
 allow delete: if false;
}
match /comments/{commentId}{allow read:if get(/databases/$(database)/documents/posts/$(postId)).data.status=='published';allow create:if signed()&&get(/databases/$(database)/documents/posts/$(postId)).data.status=='published'&&request.resource.data.keys().hasOnly(['uid','author','body','createdAt'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.createdAt==request.time&&shortText(request.resource.data.author,1,100)&&shortText(request.resource.data.body,2,500);allow update,delete:if false;}}match /reports/{id}{allow create:if signed()&&request.resource.data.keys().hasOnly(['postId','reporterUid','reason','createdAt'])&&request.resource.data.reporterUid==request.auth.uid&&request.resource.data.createdAt==request.time&&shortText(request.resource.data.postId,1,150)&&shortText(request.resource.data.reason,5,500);allow read,update,delete:if false;}
function directoryAdmin(){return signed() && request.auth.token.email == 'ionut29019@gmail.com' && request.auth.token.email_verified == true;}
match /directoryBusinesses/{businessId} {
  allow read: if resource.data.status == 'approved' || (signed() && (resource.data.uid == request.auth.uid || directoryAdmin()));
  allow create: if signed()
    && request.resource.data.keys().hasOnly(['uid','name','category','region','province','city','address','phone','whatsapp','website','hours','description','imageUrls','status','createdAt'])
    && request.resource.data.keys().hasAll(['uid','name','category','region','province','city','address','phone','whatsapp','website','hours','description','imageUrls','status','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && (request.resource.data.status == 'pending' || (directoryAdmin() && request.resource.data.status == 'approved'))
    && request.resource.data.createdAt == request.time
    && request.resource.data.imageUrls is list && request.resource.data.imageUrls.size()<=10
    && shortText(request.resource.data.name,2,110)
    && shortText(request.resource.data.category,3,80)
    && shortText(request.resource.data.region,2,70)
    && shortText(request.resource.data.province,2,70)
    && shortText(request.resource.data.city,2,70)
    && shortText(request.resource.data.address,3,180)
    && shortText(request.resource.data.phone,0,40)
    && shortText(request.resource.data.whatsapp,0,40)
    && shortText(request.resource.data.website,0,250)
    && shortText(request.resource.data.hours,0,150)
    && shortText(request.resource.data.description,25,1200);
  allow update: if directoryAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','name','description','phone','whatsapp','website','address','hours'])
    && resource.data.status in ['pending','approved']
    && request.resource.data.status in ['approved','rejected','revoked']
    && request.resource.data.reviewedAt == request.time;
  allow delete: if false;
}

match /directoryAds/{id} {
 allow read: if resource.data.status == 'approved' || (signed() && (resource.data.uid == request.auth.uid || directoryAdmin()));
 allow create: if signed()
  && request.resource.data.keys().hasOnly(['uid','businessId','title','body','imageUrl','linkUrl','status','createdAt'])
  && request.resource.data.keys().hasAll(['uid','businessId','title','body','imageUrl','linkUrl','status','createdAt'])
  && request.resource.data.uid == request.auth.uid
  && request.resource.data.status == 'pending'
  && request.resource.data.createdAt == request.time
  && exists(/databases/$(database)/documents/directoryBusinesses/$(request.resource.data.businessId))
  && get(/databases/$(database)/documents/directoryBusinesses/$(request.resource.data.businessId)).data.uid == request.auth.uid
  && get(/databases/$(database)/documents/directoryBusinesses/$(request.resource.data.businessId)).data.status == 'approved'
  && shortText(request.resource.data.title,3,250)
  && shortText(request.resource.data.body,10,500)
  && shortText(request.resource.data.imageUrl,0,250)
  && shortText(request.resource.data.linkUrl,0,250);
 allow update: if directoryAdmin()
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','startsAt','expiresAt'])
  && request.resource.data.status in ['approved','rejected']
  && (resource.data.status == 'pending' || resource.data.status == 'approved')
  && request.resource.data.reviewedAt == request.time;
 allow delete: if false;
}
match /directoryBusinessEdits/{id} {
 allow read: if directoryAdmin() || (signed() && resource.data.uid == request.auth.uid);
 allow create: if signed()
  && request.resource.data.keys().hasOnly(['uid','businessId','changes','status','createdAt'])
  && request.resource.data.uid == request.auth.uid
  && request.resource.data.status == 'pending'
  && request.resource.data.createdAt == request.time
  && request.resource.data.changes is map
  && request.resource.data.changes.keys().hasOnly(['name','description','phone','whatsapp','website','address','hours'])
  && exists(/databases/$(database)/documents/directoryBusinesses/$(request.resource.data.businessId))
  && get(/databases/$(database)/documents/directoryBusinesses/$(request.resource.data.businessId)).data.uid == request.auth.uid;
 allow update: if directoryAdmin()
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
  && request.resource.data.status in ['approved','rejected']
  && request.resource.data.reviewedAt == request.time;
 allow delete: if false;
}
match /directoryExtensionRequests/{id} {
 allow read: if directoryAdmin() || (signed() && resource.data.uid == request.auth.uid);
 allow create: if signed()
  && request.resource.data.keys().hasOnly(['uid','adId','businessId','reason','status','createdAt'])
  && request.resource.data.uid == request.auth.uid
  && request.resource.data.status == 'pending'
  && request.resource.data.createdAt == request.time
  && shortText(request.resource.data.reason,1,300)
  && exists(/databases/$(database)/documents/directoryAds/$(request.resource.data.adId))
  && get(/databases/$(database)/documents/directoryAds/$(request.resource.data.adId)).data.uid == request.auth.uid;
 allow update: if directoryAdmin()
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
  && request.resource.data.status in ['approved','rejected']
  && request.resource.data.reviewedAt == request.time;
 allow delete: if false;
}
}}