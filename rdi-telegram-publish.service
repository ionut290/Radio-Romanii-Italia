[Unit]
Description=Publish editor-approved RDI Telegram text messages to the read-only live feed

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/rdi-telegram-live/publish-approved.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rdi-telegram-live/pending /var/lib/rdi-telegram-live/approved /var/lib/docker/volumes/azuracast_station_data/_data
