[Unit]
Description=RDI: update live music inventory and analyze new AzuraCast uploads
After=docker.service
ConditionPathExists=/opt/rdi-music-dj/rdi_music_ingest.py

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/home/ubuntu
WorkingDirectory=/opt/rdi-music-dj
ExecStart=/usr/bin/python3 /opt/rdi-music-dj/rdi_music_ingest.py --new-limit 3 --duration-limit 25 --feature-limit 2
ExecStartPost=+/usr/sbin/runuser -u ubuntu -- /usr/bin/python3 /opt/rdi-music-dj/rdi_music_dj.py report
Nice=17
IOSchedulingClass=idle
CPUQuota=30%
MemoryMax=460M
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/rdi-music
PrivateNetwork=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
