[Unit]
Description=RDI free YAMNet ONNX audio tagging (100-song read-only sample)
After=docker.service
ConditionPathExists=/opt/rdi-music-dj/models/yamnet.onnx

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
WorkingDirectory=/opt/rdi-music-dj
ExecStart=/opt/rdi-music-dj/ai-venv/bin/python /opt/rdi-music-dj/rdi_music_ai.py --limit 100 --sample-size 100
ExecStartPost=/usr/bin/python3 /opt/rdi-music-dj/rdi_music_dj.py report
Nice=18
IOSchedulingClass=idle
CPUQuota=35%
MemoryMax=900M
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
