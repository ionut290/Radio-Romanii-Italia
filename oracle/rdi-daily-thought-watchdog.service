[Unit]
Description=RDI daily thought Oracle publication watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=RDI_DAILY_THOUGHT_WATCHDOG_STATE=/home/ubuntu/.local/state/rdi-daily-thought-watchdog/last_dispatch
LoadCredential=github-token:/home/ubuntu/rdi-monitor/github-token
ExecStart=/usr/bin/python3 /opt/rdi-daily-thought-watchdog/rdi-daily-thought-watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/rdi-daily-thought-watchdog

