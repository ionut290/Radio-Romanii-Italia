{
  "schema_version": 1,
  "purpose": "RDI LIVE YouTube — registro dei singoli video autorizzati",
  "updated_on": "2026-11-07",
  "default_policy": "deny",
  "sources": [
    {
      "id": "ec-audiovisual",
      "name": "Commissione europea — Audiovisual Service / Europe by Satellite",
      "catalog_url": "https://audiovisual.ec.europa.eu/",
