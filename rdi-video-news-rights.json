      "default_license": "CC BY 4.0 per contenuti di proprietà UE, salvo indicazioni differenti",
      "notes": "Controllare licenza della singola clip, musica e terzi; attribuzione obbligatoria; non implicare approvazione UE."
    },
    {
      "id": "europarl-mmc",
      "name": "Parlamento europeo — Multimedia Centre",
      "catalog_url": "https://multimedia.europarl.europa.eu/",
      "terms_url": "https://www.europarl.europa.eu/news/en/media-services/multimedia-centre",
      "default_license": "Riutilizzo con attribuzione secondo condizioni specifiche",
      "notes": "Conservare fonte e specifiche restrizioni prima di mettere in onda."
    }
  ],
  "videos": [],
  "approval_requirements": {
    "must_have": [
      "source_id",
      "title",
      "source_page_url",
      "downloaded_file_path",
      "license_name",
      "license_url",
      "attribution",
      "rights_checked_at",
      "rights_evidence",
      "approved_for_youtube_live",
      "audio_language",
      "audio_language_verified_at",
      "audio_language_verification_method",
      "published_at",
      "event_date"
    ],
    "approved_for_youtube_live_required_value": true,
    "check_third_party_music": true,
    "check_identifiable_person_rights": true,
    "allow_embed_only": false,
    "audio_language_required_value": "it",
    "foreign_source_material_requires_licensed_italian_dubbing": true,
    "italian_subtitles_do_not_qualify": true,
    "require_published_today_rome": true,
    "require_event_today_rome": true
  },
  "broadcast": {
    "enabled": false,
    "reason": "Nessun singolo filmato ancora controllato e caricato: non iniziare riproduzione automatica.",
    "required_audio_language": "it",
    "allow_foreign_audio": false,
    "allow_italian_subtitles_only": false,
    "allow_silent_video_only_with_italian_voiceover": true,
    "language_verification_required": true,
    "require_same_day_news": true,
    "news_timezone": "Europe/Rome",
    "require_event_date_today": true,
    "allow_older_footage_only_for_current_day_story": false
  }
